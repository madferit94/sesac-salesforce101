    <formulas>
        <name>fxDiffDigits</name>
        <dataType>String</dataType>
        <expression>TEXT(ABS(ROUND({!Get_Daily.Difference__c}, 0)))</expression>
    </formulas>
    <formulas>
        <name>fxDiffText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Daily.Difference__c}), "계산 안 됨 (통장 잔액 미입력)", IF({!Get_Daily.Difference__c} &gt; 0, "+", IF({!Get_Daily.Difference__c} &lt; 0, "-", "")) &amp; IF(LEN({!fxDiffDigits}) &lt;= 3, {!fxDiffDigits}, IF(LEN({!fxDiffDigits}) &lt;= 6, LEFT({!fxDiffDigits}, LEN({!fxDiffDigits}) - 3) &amp; "," &amp; RIGHT({!fxDiffDigits}, 3), IF(LEN({!fxDiffDigits}) &lt;= 9, LEFT({!fxDiffDigits}, LEN({!fxDiffDigits}) - 6) &amp; "," &amp; MID({!fxDiffDigits}, LEN({!fxDiffDigits}) - 5, 3) &amp; "," &amp; RIGHT({!fxDiffDigits}, 3), LEFT({!fxDiffDigits}, LEN({!fxDiffDigits}) - 9) &amp; "," &amp; MID({!fxDiffDigits}, LEN({!fxDiffDigits}) - 8, 3) &amp; "," &amp; MID({!fxDiffDigits}, LEN({!fxDiffDigits}) - 5, 3) &amp; "," &amp; RIGHT({!fxDiffDigits}, 3)))) &amp; "원")</expression>
    </formulas>
    <formulas>
        <name>fxFinalDigits</name>
        <dataType>String</dataType>
        <expression>TEXT(ABS(ROUND({!Get_Final.Difference__c}, 0)))</expression>
    </formulas>
    <formulas>
        <name>fxFinalDiff</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Final.Difference__c}), "계산 안 됨 (통장 잔액 미입력)", IF({!Get_Final.Difference__c} &gt; 0, "+", IF({!Get_Final.Difference__c} &lt; 0, "-", "")) &amp; IF(LEN({!fxFinalDigits}) &lt;= 3, {!fxFinalDigits}, IF(LEN({!fxFinalDigits}) &lt;= 6, LEFT({!fxFinalDigits}, LEN({!fxFinalDigits}) - 3) &amp; "," &amp; RIGHT({!fxFinalDigits}, 3), IF(LEN({!fxFinalDigits}) &lt;= 9, LEFT({!fxFinalDigits}, LEN({!fxFinalDigits}) - 6) &amp; "," &amp; MID({!fxFinalDigits}, LEN({!fxFinalDigits}) - 5, 3) &amp; "," &amp; RIGHT({!fxFinalDigits}, 3), LEFT({!fxFinalDigits}, LEN({!fxFinalDigits}) - 9) &amp; "," &amp; MID({!fxFinalDigits}, LEN({!fxFinalDigits}) - 8, 3) &amp; "," &amp; MID({!fxFinalDigits}, LEN({!fxFinalDigits}) - 5, 3) &amp; "," &amp; RIGHT({!fxFinalDigits}, 3)))) &amp; "원")</expression>
    </formulas>
    <formulas>
        <name>fxRecordLink</name>
        <dataType>String</dataType>
        <expression>"/lightning/r/Daily_Recon__c/" &amp; {!varReconId} &amp; "/view"</expression>
    </formulas>
    <formulas>
        <name>fxReportTo</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Final.Report_Manager__c}, "미지정")</expression>
    </formulas>
