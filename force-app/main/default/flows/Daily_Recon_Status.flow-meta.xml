<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Line</name>
        <label>항목 한 줄 추가</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReport</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ttAppend</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Append_No_Items</name>
        <label>남은 항목 없음 안내 추가</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReport</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ttNoItems</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Report</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Done</name>
        <label>상태 = 완료</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>완료</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Handler_Name</name>
        <label>처리 담당 이름</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHandlerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varItem.Handler_Employee__r.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Count_Line</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Header</name>
        <label>보고 머리말 작성</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varLineNo</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varReport</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ttHeader</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_In_Progress</name>
        <label>상태 = 진행 중</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>진행 중</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_No_Handler</name>
        <label>처리 담당 없음</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHandlerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varEmpty</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Count_Line</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Report</name>
        <label>상태 = 보고 필요, 보고 내용 저장</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>보고 필요</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Report_Body__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varReport</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Reported_At__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxReportedAt</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Count_Line</name>
        <label>줄 번호 증가</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varLineNo</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Append_Line</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Any_Lines</name>
        <label>항목 줄 확인</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Report</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>있음</defaultConnectorLabel>
        <rules>
            <name>No_Lines</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLineNo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Append_No_Items</targetReference>
            </connector>
            <label>없음</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Handler</name>
        <label>처리 담당 확인</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_No_Handler</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>없음</defaultConnectorLabel>
        <rules>
            <name>Has_Handler</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varItem.Handler_Employee__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Handler_Name</targetReference>
            </connector>
            <label>있음</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Status</name>
        <label>상태 판정</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Open_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>보고 필요</defaultConnectorLabel>
        <rules>
            <name>Missing_Balance</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Bank_Balance__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.System_Balance__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_In_Progress</targetReference>
            </connector>
            <label>잔액 미입력</label>
        </rules>
        <rules>
            <name>Is_Done</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxIsDone</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Done</targetReference>
            </connector>
            <label>완료</label>
        </rules>
    </decisions>
    <description>일일 대조 저장 시 상태를 판정합니다. 잔액 미입력이면 진행 중, 차이 0원이고 남은 항목 0건이면 완료, 그 밖에는 보고 필요로 바꾸고 보고 내용을 자동 작성합니다.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxAccountLabel</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Recon_Account__c})</expression>
    </formulas>
    <formulas>
        <name>fxDateLabel</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!$Record.Recon_Date__c})) &amp; &quot;/&quot; &amp; TEXT(DAY({!$Record.Recon_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>fxDepositor</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varItem.Depositor_Name__c}), &quot;(입금자명 없음)&quot;, {!varItem.Depositor_Name__c})</expression>
    </formulas>
    <formulas>
        <name>fxDiff</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Bank_Balance__c} - {!$Record.System_Balance__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxDiffDigits</name>
        <dataType>String</dataType>
        <expression>TEXT(ABS(ROUND({!fxDiff}, 0)))</expression>
    </formulas>
    <formulas>
        <name>fxDiffText</name>
        <dataType>String</dataType>
        <expression>IF({!fxDiff} &gt; 0, &quot;+&quot;, IF({!fxDiff} &lt; 0, &quot;-&quot;, &quot;&quot;)) &amp; IF(LEN({!fxDiffDigits}) &lt;= 3, {!fxDiffDigits}, IF(LEN({!fxDiffDigits}) &lt;= 6, LEFT({!fxDiffDigits}, LEN({!fxDiffDigits}) - 3) &amp; &quot;,&quot; &amp; RIGHT({!fxDiffDigits}, 3), IF(LEN({!fxDiffDigits}) &lt;= 9, LEFT({!fxDiffDigits}, LEN({!fxDiffDigits}) - 6) &amp; &quot;,&quot; &amp; MID({!fxDiffDigits}, LEN({!fxDiffDigits}) - 5, 3) &amp; &quot;,&quot; &amp; RIGHT({!fxDiffDigits}, 3), LEFT({!fxDiffDigits}, LEN({!fxDiffDigits}) - 9) &amp; &quot;,&quot; &amp; MID({!fxDiffDigits}, LEN({!fxDiffDigits}) - 8, 3) &amp; &quot;,&quot; &amp; MID({!fxDiffDigits}, LEN({!fxDiffDigits}) - 5, 3) &amp; &quot;,&quot; &amp; RIGHT({!fxDiffDigits}, 3))))</expression>
    </formulas>
    <formulas>
        <name>fxHandlerSuffix</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varHandlerName}), &quot;&quot;, &quot; (처리 담당: &quot; &amp; {!varHandlerName} &amp; IF(ISBLANK({!varItem.Report_Manager__c}), &quot;&quot;, &quot; → 보고: &quot; &amp; {!varItem.Report_Manager__c}) &amp; &quot;)&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxIsDone</name>
        <dataType>Boolean</dataType>
        <expression>AND({!fxDiff} = 0, {!fxOpenCount} = 0)</expression>
    </formulas>
    <formulas>
        <name>fxItemAmount</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!fxItemDigits}) &lt;= 3, {!fxItemDigits}, IF(LEN({!fxItemDigits}) &lt;= 6, LEFT({!fxItemDigits}, LEN({!fxItemDigits}) - 3) &amp; &quot;,&quot; &amp; RIGHT({!fxItemDigits}, 3), IF(LEN({!fxItemDigits}) &lt;= 9, LEFT({!fxItemDigits}, LEN({!fxItemDigits}) - 6) &amp; &quot;,&quot; &amp; MID({!fxItemDigits}, LEN({!fxItemDigits}) - 5, 3) &amp; &quot;,&quot; &amp; RIGHT({!fxItemDigits}, 3), LEFT({!fxItemDigits}, LEN({!fxItemDigits}) - 9) &amp; &quot;,&quot; &amp; MID({!fxItemDigits}, LEN({!fxItemDigits}) - 8, 3) &amp; &quot;,&quot; &amp; MID({!fxItemDigits}, LEN({!fxItemDigits}) - 5, 3) &amp; &quot;,&quot; &amp; RIGHT({!fxItemDigits}, 3))))</expression>
    </formulas>
    <formulas>
        <name>fxItemDigits</name>
        <dataType>String</dataType>
        <expression>TEXT(ABS(ROUND({!varItem.Amount__c}, 0)))</expression>
    </formulas>
    <formulas>
        <name>fxLineNoText</name>
        <dataType>String</dataType>
        <expression>TEXT({!varLineNo})</expression>
    </formulas>
    <formulas>
        <name>fxOpenCount</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.Open_Item_Count__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxOpenCountText</name>
        <dataType>String</dataType>
        <expression>TEXT({!fxOpenCount})</expression>
    </formulas>
    <formulas>
        <name>fxReportTo</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TRIM({!$Record.Owner_Employee__r.Manager_Employee__r.Role__c} &amp; &quot; &quot; &amp; {!$Record.Owner_Employee__r.Manager_Employee__r.Name}), &quot;미지정&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxReportedAt</name>
        <dataType>DateTime</dataType>
        <expression>IF(ISBLANK({!$Record.Reported_At__c}), {!$Flow.CurrentDateTime}, {!$Record.Reported_At__c})</expression>
    </formulas>
    <interviewLabel>일일 대조 상태 판정 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>일일 대조 상태 판정</label>
    <loops>
        <name>Loop_Items</name>
        <label>남은 항목 반복</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varItem</assignNextValueToReference>
        <collectionReference>Get_Open_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Has_Handler</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Any_Lines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Items</name>
        <label>남은 항목 조회</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Header</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Daily_Recon__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Resolved__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Recon_Item__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Status</targetReference>
        </connector>
        <object>Daily_Recon__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttAppend</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!varReport}
{!fxLineNoText}. {!fxDepositor} {!varItem.Direction__c} {!fxItemAmount}원 - {!varItem.Cause__c}{!fxHandlerSuffix}</text>
    </textTemplates>
    <textTemplates>
        <name>ttHeader</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>[{!fxDateLabel} {!fxAccountLabel} 계좌 대조 결과 보고]
차이 금액: {!fxDiffText}원 / 남은 항목 {!fxOpenCountText}건
보고 대상: {!fxReportTo}</text>
    </textTemplates>
    <textTemplates>
        <name>ttNoItems</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!varReport}
- 남은 항목 없이 잔액 차이만 있음: 원인 확인 필요</text>
    </textTemplates>
    <variables>
        <name>varEmpty</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varHandlerName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Recon_Item__c</objectType>
    </variables>
    <variables>
        <name>varLineNo</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varReport</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
