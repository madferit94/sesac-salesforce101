<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_New_Item_On_Completed</fullName>
    <active>true</active>
    <description>완료된 대조에는 미대조 항목을 새로 추가할 수 없음</description>
    <errorConditionFormula
  >AND(NOT($Permission.Recon_Override), ISNEW(), ISPICKVAL(Daily_Recon__r.Status__c, "완료"))</errorConditionFormula>
    <errorMessage
  >완료된 대조에는 항목을 추가할 수 없습니다. 새 대조를 만들거나 관리자에게 요청하세요.</errorMessage>
</ValidationRule>
