<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Assign_Advisor_Manager</name>
        <label>처리 직원 = 담당 직원의 상위 직원</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Current_Handler__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Advisor__r.Manager_Employee__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Reason_Time</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Clear</name>
        <label>에스컬레이션 결과 비우기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Current_Handler__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varEmptyText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Escalation_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varEmptyText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Escalated_At__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varEmptyDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Consult_Manager</name>
        <label>처리 직원 = 상담의 상위 담당 직원</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Current_Handler__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Manager_Employee__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Reason_Time</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Reason_Time</name>
        <label>사유·시각 기록</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Escalation_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxEscalationReason</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Escalated_At__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Error_No_Handler</name>
        <label>넘겨받을 직원 없음 오류</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>넘겨받을 상위 직원이 없어 에스컬레이션할 수 없습니다. 담당 직원의 상위 직원 또는 상담의 상위 담당 직원을 지정해 주세요.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Decision_Escalation_Status</name>
        <label>에스컬레이션 상태 확인</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>처리완료/기타</defaultConnectorLabel>
        <rules>
            <name>Is_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Escalation_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>요청</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Handler</targetReference>
            </connector>
            <label>요청</label>
        </rules>
        <rules>
            <name>Is_Not_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Escalation_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>미요청</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Clear</targetReference>
            </connector>
            <label>미요청</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Handler</name>
        <label>넘겨받을 직원 찾기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_No_Handler</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>없음</defaultConnectorLabel>
        <rules>
            <name>Advisor_Has_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Advisor__r.Manager_Employee__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Advisor_Manager</targetReference>
            </connector>
            <label>담당 직원의 상위 직원 있음</label>
        </rules>
        <rules>
            <name>Consultation_Has_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Manager_Employee__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Consult_Manager</targetReference>
            </connector>
            <label>상담의 상위 담당 직원 있음</label>
        </rules>
    </decisions>
    <description>에스컬레이션 상태가 '요청'으로 저장되면 담당 직원의 상위 직원(없으면 상담의 상위 담당 직원)을 현재 처리 직원으로 지정하고 사유·시각을 기록합니다. '미요청'이면 결과를 비우고, '처리완료'는 변경하지 않습니다.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxEscalationReason</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Assistance_Reason__c}), &quot;담당 직원 직접 요청&quot;, {!$Record.Assistance_Reason__c})</expression>
    </formulas>
    <interviewLabel>Luxury Consultation Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Luxury Consultation Escalation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Escalation_Status</targetReference>
        </connector>
        <object>Luxury_Client_Consultation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>varEmptyDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varEmptyText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
